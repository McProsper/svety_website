---
import { Megaphone, ScanEye, PenLine } from "lucide-astro";
import Layout from "../layouts/Layout.astro";
import BookingSection from "../components/BookingSection.astro";

const offers = [
  {
    icon: Megaphone,
    title: "Stratégie Marketing & Communication",
    text: "Élaboration de plans de communication intégrés, positionnement de marque et analyse d'audience — du diagnostic à la ligne éditoriale.",
  },
  {
    icon: ScanEye,
    title: "Audit & Conseil en Neuromarketing",
    text: "Analyse cognitive des visuels et des parcours clients, optimisation de la perception de marque, arbitrage entre clarté et émotion.",
  },
  {
    icon: PenLine,
    title: "Ingénierie d'Affaires & Storytelling",
    text: "Conduite de projets d'affaires, rédaction stratégique et conception de contenus à fort impact émotionnel, alignés sur vos objectifs.",
  },
];

const steps = [
  { n: "01", title: "Écoute & analyse sociologique", text: "Comprendre le contexte, les publics, les normes et les tensions." },
  { n: "02", title: "Stratégie neuro-centrée", text: "Prioriser les leviers d'attention, de mémoire et de décision." },
  { n: "03", title: "Déploiement", text: "Messages, supports et parcours : une exécution sobre et cohérente." },
  { n: "04", title: "Optimisation", text: "Observer, ajuster, affiner — sans bruit inutile." },
];
---

<Layout
  title="Services"
  description="Accompagnement en marketing, communication, neuromarketing et ingénierie d'affaires. Prise de rendez-vous par calendrier."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-20 md:pt-28">
    <p class="text-sm font-medium tracking-[0.18em] text-muted uppercase">Conseil</p>
    <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">
      Accompagnement, Stratégie & Ingénierie d'Affaires
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Un conseil à l'intersection de la stratégie, des sciences cognitives et du récit. Pour des marques et des projets qui veulent être compris — pas seulement vus.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-5 md:grid-cols-3">
      {
        offers.map((offer) => (
          <article class="apple-card apple-hover p-7">
            <div class="mb-8 flex h-11 w-11 items-center justify-center rounded-2xl bg-canvas dark:bg-black">
              <offer.icon size={20} stroke-width={1.5} />
            </div>
            <h2 class="text-xl font-semibold tracking-tight">{offer.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{offer.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl font-semibold tracking-tight">Processus de travail</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="relative">
            {index < steps.length - 1 && (
              <span class="pointer-events-none absolute left-8 right-[-12px] top-5 hidden h-px bg-black/10 md:block dark:bg-white/10" />
            )}
            <p class="text-sm text-muted">{step.n}</p>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20">
    <BookingSection />
  </section>
</Layout>
