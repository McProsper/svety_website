---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PoemeCard from "../components/PoemeCard.astro";

const poemes = (await getCollection("poemes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="Plume & Poésie"
  description="Atelier littéraire : poèmes illustrés, extraits et œuvres personnelles."
  literary
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-20 md:pt-28">
    <p class="font-sans text-sm font-medium tracking-[0.22em] text-muted uppercase">Littérature</p>
    <h1 class="mt-4 max-w-3xl font-serif text-5xl font-light tracking-tight md:text-7xl">
      L'Atelier : Mots, Vers & Œuvres
    </h1>
    <p class="mt-6 max-w-xl font-serif text-lg italic leading-relaxed text-muted">
      Un espace plus silencieux. Ici, la langue n'argumente pas : elle éclaire, elle retient, elle laisse une image.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-6 md:grid-cols-2">
      {poemes.map((poeme) => <PoemeCard poeme={poeme} />)}
    </div>
  </section>
</Layout>
