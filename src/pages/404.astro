---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable">
  <section class="mx-auto max-w-3xl px-4 py-32 text-center">
    <p class="text-sm tracking-[0.2em] text-muted uppercase">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Cette page s'est égarée.</h1>
    <p class="mt-3 text-muted">Revenez à l'accueil, ou ouvrez l'atelier.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Accueil</a>
      <a href="/plume" class="btn-secondary">Plume</a>
    </div>
  </section>
</Layout>
