---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/dates";

type Props = { poeme: CollectionEntry<"poemes"> };
const { poeme } = Astro.props;
const href = `/plume/${poeme.id}`;
---

<a href={href} class="apple-card apple-hover group block overflow-hidden">
  <img
    src={poeme.data.illustration}
    alt={poeme.data.altIllustration}
    class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    loading="lazy"
  />
  <div class="p-6">
    <div class="mb-3 flex items-center justify-between text-xs text-muted">
      <span class="italic">{poeme.data.theme}</span>
      <time datetime={poeme.data.date.toISOString()}>{formatDate(poeme.data.date)}</time>
    </div>
    <h3 class="font-serif text-2xl font-normal tracking-tight">{poeme.data.title}</h3>
    <p class="mt-3 font-serif text-sm italic leading-relaxed text-muted">{poeme.data.excerpt}</p>
  </div>
</a>
